    <creationDate>2026-05-07</creationDate>
    <author>Konstantin Kutsevalov &amp; Vladislav Smolenskiy</author>
    <authorUrl>http://kutsevalov.name</authorUrl>
    <copyright>All rights reserved</copyright>
    <license>GNU General Public License version 2 or later</license>
    <version>4.0.0</version>
    <minimumJoomla>6.0.0</minimumJoomla>
    <minimumPhp>8.3.0</minimumPhp>
    <description>COM_MYCITYSELECTOR_DESCRIPTION</description>

    <files folder="site"><filename>controller.php</filename><folder>controllers</folder><filename>index.html</filename><folder>language</folder><folder>models</folder><filename>mycityselector.php</filename><filename>robots.txt.php</filename><filename>sitemap.xml.php</filename><folder>views</folder></files>

    <languages folder="site">
        <language tag="en-GB">language/en-GB/en-GB.com_mycityselector.ini</language>
        <language tag="en-GB">language/en-GB/en-GB.com_mycityselector.sys.ini</language>
        <language tag="ru-RU">language/ru-RU/ru-RU.com_mycityselector.ini</language>
        <language tag="ru-RU">language/ru-RU/ru-RU.com_mycityselector.sys.ini</language>
    </languages>

    <administration>
        <files folder="admin"><filename>access.xml</filename><folder>assets</folder><filename>config.xml</filename><filename>controller.php</filename><folder>controllers</folder><folder>experimental</folder><folder>helpers</folder><folder>images</folder><filename>index.html</filename><filename>installer.css</filename><filename>installer.php</filename><filename>installer.tmpl.php</filename><folder>language</folder><folder>migrations</folder><folder>models</folder><filename>mycityselector.php</filename><folder>tables</folder><folder>views</folder></files>

        <languages folder="admin">
            <language tag="en-GB">language/en-GB/en-GB.com_mycityselector.sys.ini</language>
            <language tag="en-GB">language/en-GB/en-GB.com_mycityselector.ini</language>
            <language tag="ru-RU">language/ru-RU/ru-RU.com_mycityselector.sys.ini</language>
            <language tag="ru-RU">language/ru-RU/ru-RU.com_mycityselector.ini</language>
        </languages>
    </administration>

    <updateservers>
        <server type="extension" name="My City Selector">https://raw.githubusercontent.com/joomx/mycityselector/master/mcs_update.xml</server>
    </updateservers>
</extension>
