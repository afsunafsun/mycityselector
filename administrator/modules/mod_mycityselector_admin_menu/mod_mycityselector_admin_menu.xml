    <author>Konstantin Kutsevalov &amp; Vladislav Smolenskiy</author>
    <authorUrl>http://kutsevalov.name</authorUrl>
    <copyright>All rights reserved</copyright>
    <license>GNU General Public License version 2 or later</license>
    <version>4.0.0</version>
    <minimumJoomla>6.0.0</minimumJoomla>
    <minimumPhp>8.3.0</minimumPhp>
	<description>MOD_MYCITYSELECTORADMINMENU_DESCRIPTION</description>

	<files><folder>language</folder><filename module="mod_mycityselector_admin_menu">mod_mycityselector_admin_menu.php</filename><filename>mod_mycityselector_admin_menu.xml</filename><folder>tmpl</folder></files>

	<config>
		<fields name="params">
			<fieldset name="advanced">
				<field name="layout" type="modulelayout" label="JFIELD_ALT_LAYOUT_LABEL" description="JFIELD_ALT_MODULE_LAYOUT_DESC"/>
			</fieldset>
		</fields>
	</config>

	<languages>
		<language tag="en-GB">language/en-GB/en-GB.mod_mycityselector_admin_menu.ini</language>
		<language tag="en-GB">language/en-GB/en-GB.mod_mycityselector_admin_menu.sys.ini</language>
		<language tag="ru-RU">language/ru-RU/ru-RU.mod_mycityselector_admin_menu.ini</language>
		<language tag="ru-RU">language/ru-RU/ru-RU.mod_mycityselector_admin_menu.sys.ini</language>
	</languages>
</extension>
